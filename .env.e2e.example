# Copy to .env.e2e (gitignored). Never commit real keys.
# Target. Default http://localhost:3000 (Playwright starts `npm run dev`; E2E_SERVER=start uses a production build).
E2E_BASE_URL=
# Signed-in suites: the Clerk *Development* test user (npm run e2e:user creates it). Sign-in uses a Clerk ticket, no password.
E2E_USER_EMAIL=e2e+clerk_test@example.com
# The local app runs on this test database (npm run test:db:up). Required for @writes on localhost.
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/trademaster_test
# Taken from .env when the app runs locally; must be sk_test_ (live keys are refused).
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Tests tagged @writes create and delete data (only on the test database, see E2E_DATABASE_URL).
E2E_ALLOW_WRITES=1
# Non-local hosts allowed for @writes (comma-separated). Never the production host.
E2E_WRITE_HOSTS=
# Protected Vercel previews (Project → Settings → Deployment Protection → Protection Bypass for Automation).
VERCEL_AUTOMATION_BYPASS_SECRET=
# 1 = also run the public suite on WebKit (iPhone 14).
E2E_WEBKIT=0
