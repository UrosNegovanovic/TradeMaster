// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User profile linked to Clerk user ID
model Profile {
  id           String   @id @default(cuid())
  clerkUserId  String   @unique // Clerk user ID
  companyName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  pib          String? // Tax ID (PIB)
  registrationNumber String? // Matični broj (8 digits), required for the SEF XML
  giroAccount  String? // Merchant žiro-račun printed on invoices
  logoUrl      String? // URL to uploaded logo (stored in Supabase Storage)
  inVatSystem  Boolean  @default(false) // Company is in the PDV system; new invoices carry VAT
  defaultPaymentDays Int? // Default "rok" for new documents in days (NULL = 30), ROADMAP A9.22
  invoiceNote  String? // Default note prefilled on new documents, ROADMAP A9.22
  accessExpiresAt DateTime? // Manual billing: access until this day (Belgrade midnight); NULL = no limit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  products       Product[]
  catalogs       Catalog[]
  invoices       Invoice[]
  stockMovements StockMovement[]
  productIntakes ProductIntake[]
  categories     Category[]
  clients        Client[]
  sefCredential  SefCredential?
  accessExtensions AccessExtension[]

  @@map("profiles")
}

/// One row per confirmed payment that extended access (manual billing, scripts/extend-access.ts).
/// `reference` (predračun/faktura number, normalized) is unique: the same payment never extends twice.
model AccessExtension {
  id                String    @id @default(cuid())
  profileId         String
  reference         String    @unique
  paidOn            DateTime  @db.Date // Bank statement date, not the day "Plaćeno" was clicked
  basis             String // 'continue' | 'reactivate' (src/lib/access-period.ts)
  periodFrom        DateTime  @db.Date
  periodUntil       DateTime  @db.Date
  anchorDay         Int // Renewal day of the month, 31 = always the last day
  previousExpiresAt DateTime?
  newExpiresAt      DateTime
  createdAt         DateTime  @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("access_extensions")
}

/// One SEF API key per company (ROADMAP A3), AES-256-GCM encrypted (src/lib/sef-key-crypto.ts).
/// Separate table so no profile include can return it; read only by the SEF routes.
model SefCredential {
  profileId        String   @id
  apiKeyCiphertext String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("sef_credentials")
}

// Durable receipts for retries; written atomically with the stock change.
model ProductIntake {
  profileId String
  key       String
  fingerprint String
  response  Json
  status    Int
  createdAt DateTime @default(now())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, key])
  @@map("product_intakes")
}

// Product categories — scoped per merchant (profile), not a global list
model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Relations
  products Product[]

  @@unique([profileId, name])
  @@index([profileId])
  @@map("categories")
}

// Saved buyers — scoped per merchant. Invoices copy these fields (snapshot), there is no FK.
model Client {
  id        String   @id @default(cuid())
  name      String
  pib       String?
  registrationNumber String? // Matični broj (8 digits), used for the SEF XML (matched by PIB)
  address   String?
  phone     String? // For reminders and shared links straight to the buyer (wa.me), ROADMAP A9.21
  email     String? // mailto: recipient, ROADMAP A9.21
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, name])
  @@map("clients")
}

// Product inventory
model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String
  price       Decimal  @default(0) @db.Decimal(10, 2) // Default sale price; prefills invoice items, never rewrites history
  costPrice   Decimal? @db.Decimal(10, 2) // Current purchase cost; nullable for legacy rows, required on ProductForm writes
  costPriceZeroReason String? // Free-text note required by the app when costPrice is 0; not an enum
  imageUrl    String? // URL to product image (stored in Supabase Storage)
  description String?
  quantity    Int      @default(0) // Current stock quantity
  minStock    Int      @default(2) // Alert only when stock is nearly gone
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  profileId  String
  categoryId String?

  // Relations
  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  catalogItems   CatalogItem[]
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  // Indexes
  // Unique (profileId, sku) is deferred: leftover daily-batch rows still exist in production.
  // Intake updates the latest row; CSV adjust consolidates stock onto that row without deleting history.
  // @@unique([profileId, sku])
  @@index([profileId])
  @@index([sku]) // Added index for SKU lookups
  @@index([categoryId])
  @@index([createdAt]) // Added index for date-based queries
  @@index([profileId, sku]) // Compound index for product lookups
  @@index([profileId, createdAt])
  @@map("products")
}

// Catalog (collection of products with client-specific discount)
model Catalog {
  id           String   @id @default(cuid())
  name         String // Catalog name/identifier
  clientName   String? // Client name (optional)
  discount     Decimal  @db.Decimal(5, 2) // Discount percentage (e.g., 15.50 for 15.5%)
  notes        String? // Additional notes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shareToken   String?  @unique
  shareEnabled Boolean  @default(false)
  shareViewCount    Int       @default(0) // Opens of the public link (API reads, not link previews)
  shareLastViewedAt DateTime?

  // Display settings shared by the PDF, owner preview and public link (values: src/lib/catalog-layout.ts)
  layout            String  @default("GRID_4") // GRID_4 | GRID_12 | LIST
  groupByCategory   Boolean @default(false)
  sortMode          String  @default("MANUAL") // MANUAL | NAME | PRICE_ASC | PRICE_DESC
  showSku           Boolean @default(true)
  showDescription   Boolean @default(true)
  showOriginalPrice Boolean @default(true)

  // Foreign keys
  profileId String

  // Relations
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   CatalogItem[]

  @@index([profileId])
  @@index([profileId, createdAt]) // 🚀 Performance: Faster catalog history queries
  @@map("catalogs")
}

// Junction table: Products in a catalog with their discounted prices
model CatalogItem {
  id String @id @default(cuid())

  // Calculated prices (stored for historical reference)
  originalPrice   Decimal @db.Decimal(10, 2) // Product price at time of catalog creation
  discountedPrice Decimal @db.Decimal(10, 2) // Calculated discounted price

  // Order/position in catalog
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  // Foreign keys
  catalogId String
  productId String

  // Relations
  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Ensure a product appears only once per catalog
  @@unique([catalogId, productId])
  @@index([catalogId])
  @@index([productId])
  @@map("catalog_items")
}

// Invoice model
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String // "01/2026" for invoices, "PR-01/2026" for proformas (per-year sequences, see src/lib/invoice-number.ts)
  createdAt     DateTime      @default(now())
  dueDate       DateTime
  clientName    String
  clientAddress String?
  note          String? // Note printed on this document, snapshot of what it was issued with (ROADMAP A9.22)
  clientPib     String? // Buyer PIB (9 digits) printed on the invoice
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Decimal       @db.Decimal(10, 2) // Amount payable (osnovica + PDV)
  vatEnabled    Boolean       @default(false) // Snapshot of Profile.inVatSystem at issue time
  vatAmount     Decimal       @default(0) @db.Decimal(10, 2) // Total PDV; osnovica = totalAmount - vatAmount
  paidAt        DateTime?
  shareToken    String?       @unique // Revocable public link; only issued invoices are served
  shareEnabled  Boolean       @default(false)
  documentType  DocumentType  @default(INVOICE) // PROFORMA = predračun: own number series, no stock, no revenue
  convertedInvoiceId String?  @unique // Proforma only: the invoice it was turned into

  // SEF sending (ROADMAP A3, src/lib/sef-send.ts). Set once the invoice is claimed for sending;
  // a sent invoice is never edited or deleted here (storno goes through SEF).
  sefRequestId       String?   @unique // Stable requestId sent to SEF: retries never create a second SEF invoice
  sefInvoiceId       String? // SEF salesInvoiceId (int64 kept as text: JSON-safe, no precision loss)
  sefStatus          String? // SENDING | SENT | APPROVED | REJECTED | CANCELLED | STORNO | MISTAKE | UNKNOWN
  sefStatusComment   String? // Buyer's rejection reason, cancel or storno comment from SEF
  sefSentAt          DateTime?
  sefStatusCheckedAt DateTime?
  sefLastError       String? // Last send error shown to the user (Serbian sentence)

  // Foreign keys
  profileId String

  // Relations
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items            InvoiceItem[]
  stockMovements   StockMovement[]
  convertedInvoice Invoice?        @relation("ProformaConversion", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  sourceProforma   Invoice?        @relation("ProformaConversion")

  @@index([profileId])
  @@index([invoiceNumber])
  @@index([profileId, createdAt]) // 🚀 Performance: Faster invoice history queries
  @@index([profileId, status])
  @@index([profileId, paidAt])
  @@index([profileId, documentType])
  @@index([profileId, sefStatus])
  @@map("invoices")
}

enum DocumentType {
  INVOICE
  PROFORMA
}

// Invoice status enum
enum InvoiceStatus {
  DRAFT
  PAID
  UNPAID
}

// Invoice item model
model InvoiceItem {
  id          String  @id @default(cuid())
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  unitCost    Decimal? @db.Decimal(10, 2) // Purchase-cost snapshot used for historical profit
  discount    Decimal @db.Decimal(5, 2) @default(0) // Discount percentage (e.g., 15.50 for 15.5%)
  vatRate     Decimal @default(0) @db.Decimal(5, 2) // PDV rate snapshot: 0, 10 or 20 (unitPrice and total exclude PDV)
  total       Decimal @db.Decimal(10, 2) // quantity * unitPrice * (1 - discount/100), excluding PDV
  productName String // Snapshot of product name (even if product is deleted)

  // Foreign keys
  invoiceId String
  productId String? // Optional: links to Product if exists

  // Relations
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

// Stock Movement Type enum
enum MovementType {
  IN
  OUT
}

enum StockMovementSource {
  INTAKE
  INVOICE
  MANUAL
}

// Stock Movement model - tracks inventory changes
model StockMovement {
  id        String              @id @default(cuid())
  type      MovementType // IN or OUT
  quantity  Int // Amount moved
  reason    String // e.g., "Purchase", "Sale", "Damaged", "Return"
  source    StockMovementSource @default(MANUAL)
  sourceKey String? // intake:<key> or invoice:<invoiceId>:<productId>
  createdAt DateTime            @default(now())

  // Foreign keys
  profileId String
  productId String
  invoiceId String?

  // Relations
  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([profileId, source, sourceKey])
  @@index([profileId])
  @@index([productId])
  @@index([invoiceId])
  @@index([createdAt])
  @@index([profileId, createdAt]) // 🚀 CRITICAL: Faster warehouse history queries (10x faster)
  @@map("stock_movements")
}
