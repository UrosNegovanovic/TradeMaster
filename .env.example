# ====================================
# TradeMaster - Environment Variables
# ====================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ====================================
# DATABASE (Supabase PostgreSQL)
# ====================================
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ====================================
# AUTHENTICATION (Clerk)
# ====================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# In-app fallback after sign-in/up (defaults to / if unset). Match Clerk Dashboard
# Paths: After sign-in URL and After sign-up URL = /dashboard. Do not use pk_live_
# until Phase 3 (own domain + Clerk Production).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ====================================
# STORAGE (Supabase)
# ====================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only. Required for Clerk-authenticated /api/uploads and product image persist.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ====================================
# APPLICATION
# ====================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ====================================
# OBSERVABILITY (optional, off unless set)
# ====================================
# Vercel Analytics page views + milestone events (signup, first_product, first_invoice, catalog_shared, invoice_shared).
# Events carry no properties or personal data. Also enable Web Analytics in the Vercel project.
NEXT_PUBLIC_ANALYTICS=on
# Sentry error reporting. Empty = Sentry is not bundled or started. Events are scrubbed (no user, cookies, bodies).
NEXT_PUBLIC_SENTRY_DSN=
# Only for readable stack traces (source map upload at build time):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ====================================
# RATE LIMIT STORE (optional)
# ====================================
# Shared counter for public/share endpoints across Vercel instances (Upstash Redis or Vercel KV REST API).
# Empty = per-instance in-memory limiter. A store outage never blocks users.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SEF sending (ROADMAP A3). Off until SEF_KEY_ENCRYPTION_KEY is set.
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts each company's SEF API key (AES-256-GCM). Losing it means every company re-enters its key.
SEF_KEY_ENCRYPTION_KEY=
# Demo by default. Production (https://efaktura.mfin.gov.rs) also needs SEF_ALLOW_PRODUCTION=on.
SEF_API_BASE_URL=https://demoefaktura.mfin.gov.rs
SEF_ALLOW_PRODUCTION=

# ====================================
# AUTOMATIC PREDRAČUN (manual billing, docs/billing-runbook.md)
# ====================================
# Vercel Cron calls /api/cron/billing daily with "Authorization: Bearer $CRON_SECRET" (Vercel sets it).
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Profile id of the owner's company that issues the predračuni (T&G Nest).
BILLING_ISSUER_PROFILE_ID=
# "on" = e-mail predračuni to customers. Anything else (default) = predračun is made and e-mailed ONLY to
# BILLING_EMAIL_BCC (the owner forwards it); without BILLING_EMAIL_BCC nothing is written or sent.
BILLING_AUTO_SEND=
# Other profiles of the owner's own company that must never be billed (comma-separated profile ids).
BILLING_EXCLUDE_PROFILE_IDS=
# Resend (resend.com → API Keys). Until the domain is verified only the Resend account's own address receives mail.
RESEND_API_KEY=
# e.g. TradeMaster <racuni@trademaster.rs> after the domain is verified; empty = Resend test sender.
BILLING_EMAIL_FROM=
# Owner's copy of every predračun e-mail, and where customer replies go.
BILLING_EMAIL_BCC=
BILLING_EMAIL_REPLY_TO=

# ====================================
# OPERATOR (seller data on /uslovi and /privatnost; never committed to the code)
# ====================================
OPERATOR_PIB=
OPERATOR_MB=
OPERATOR_ADDRESS=

# ====================================
# CLERK DEVELOPMENT -> PRODUCTION CUTOVER (owner's machine only, docs/identity-cutover-runbook.md)
# ====================================
# Never set these in Vercel. `npm run clerk:link` reads the old account with CLERK_SECRET_KEY (must be sk_test_)
# and creates production users with this key (must be sk_live_), only in the --create-users step.
CLERK_PRODUCTION_SECRET_KEY=
# Database of the rehearsal copy. Empty = DATABASE_URL (production).
IDENTITY_LINK_DATABASE_URL=
